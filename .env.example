# --- Used by docker compose ---
# Long random string used to sign logins. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# The public URL people use to reach the app (used in invite links). Use https in production.
APP_URL="http://localhost:3000"
# Optional: enables the GitHub integration (any random string; use the same value in the GitHub webhook)
GITHUB_WEBHOOK_SECRET=""
# Password for the bundled Postgres container
POSTGRES_PASSWORD="change-me-too"

# --- Only needed when running without docker (npm run dev / npm start) ---
DATABASE_URL="postgresql://trackr:trackr@localhost:5432/trackr"
# Direct (non-pooled) connection used for migrations. Same as DATABASE_URL unless you use Neon.
DATABASE_URL_UNPOOLED="postgresql://trackr:trackr@localhost:5432/trackr"

# --- Vercel + Neon: see DEPLOY-VERCEL.md. Vercel's Neon and Blob integrations set these for you ---
# DATABASE_URL="postgresql://…@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# DATABASE_URL_UNPOOLED="postgresql://…@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_…"
