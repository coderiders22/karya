    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^0.460.0",
    "next": "^15.5.29",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "1.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
